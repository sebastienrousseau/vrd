# SPDX-License-Identifier: Apache-2.0 OR MIT
#
# Smaller alternative: musl-static Alpine build. Final image
# is ~3 MB. Use when distroless's 10 MB is too large for your
# deployment (edge nodes, embedded gateways).

# ─── Build stage ───────────────────────────────────────────
FROM rust:1.85-alpine AS build

RUN apk add --no-cache musl-dev
WORKDIR /src
COPY . .

# musl target for static binary.
ENV CARGO_TERM_COLOR=always
RUN rustup target add x86_64-unknown-linux-musl && \
    cargo build --release --bin vrd --target x86_64-unknown-linux-musl

# ─── Runtime stage (alpine) ────────────────────────────────
FROM alpine:3.21

LABEL org.opencontainers.image.source="https://github.com/sebastienrousseau/vrd"
LABEL org.opencontainers.image.description="Lightweight, no_std-friendly random number generator for Rust - CLI demo, musl-static"
LABEL org.opencontainers.image.licenses="Apache-2.0 OR MIT"
LABEL org.opencontainers.image.version="__VERSION__"
LABEL org.opencontainers.image.revision="__COMMIT__"

COPY --from=build /src/target/x86_64-unknown-linux-musl/release/vrd /usr/local/bin/vrd

RUN addgroup -S vrd && adduser -S vrd -G vrd
USER vrd

ENTRYPOINT ["/usr/local/bin/vrd"]
CMD ["--help"]
